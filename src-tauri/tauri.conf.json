{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SLClean",
  "version": "0.1.0",
  "identifier": "vn.salyyy.slclean",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SLClean",
        "width": 1180,
        "height": 660,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "center": true,
        "decorations": true,
        "backgroundColor": "#101512"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
